    "CC 87 value 127 switches the unit to STOMP mode, 0 back to PRESET mode. In STOMP mode the four keys can be given blocks with NRPN 10/3..6." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CC 87 value 127 switches the unit to STOMP mode, 0 back to PRESET mode. In STOMP mode the four keys can be given blocks with NRPN 10/3..6."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CC 87 값 127은 기기를 STOMP 모드로, 0은 PRESET 모드로 바꿉니다. STOMP 모드에서는 NRPN 10/3~6으로 네 개의 키에 블록을 지정할 수 있습니다."
          }
        }
      }
    },
    "CC 88 (save)" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
