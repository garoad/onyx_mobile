    },
    "CC 99 = module, CC 98 = parameter, CC 6 = high 7 bits, optional CC 38 = low 7 bits: 14 bit -> 0..100 %. CC 6 alone: 0..127 -> 0..100 %." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CC 99 = module, CC 98 = parameter, CC 6 = high 7 bits, optional CC 38 = low 7 bits: 14 bit -> 0..100 %. CC 6 alone: 0..127 -> 0..100 %."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CC 99 = 모듈, CC 98 = 파라미터, CC 6 = 상위 7비트, 선택적으로 CC 38 = 하위 7비트: 14비트 -> 0~100 %. CC 6만 보내면 0~127 -> 0~100 %."
          }
        }
      }
    },
