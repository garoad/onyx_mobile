    "The recording includes what the PC plays; off breaks a monitoring loop." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The recording includes what the PC plays; off breaks a monitoring loop."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "녹음에 PC에서 재생되는 소리가 포함됩니다. 끄면 모니터링 루프가 끊어집니다."
          }
        }
      }
    },
    "The sound in this slot is replaced and cannot be restored." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sound in this slot is replaced and cannot be restored."
