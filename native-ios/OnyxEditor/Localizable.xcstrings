    "Allow Bluetooth for Onyx Editor in Settings > Privacy & Security > Bluetooth." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow Bluetooth for Onyx Editor in Settings > Privacy & Security > Bluetooth."
